# Public values are inlined at build time. Set them before `npm run build`
# and before a Netlify production build.

# Project URL, https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Prefer the new publishable key. The legacy anon key is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Used by the agent MCP endpoint and when adding an agent.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical origin for the MCP URL shown on Agents. Inlined at build time.
# Example: https://board.example.netlify.app
NEXT_PUBLIC_SITE_URL=
